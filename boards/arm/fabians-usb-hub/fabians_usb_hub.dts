/dts-v1/;

#include <mem.h>
#include <st/l1/stm32l151.dtsi>
#include <st/l1/stm32l151c(6-8-b)tx-pinctrl.dtsi>

/ {
    model = "Fabians USB Hub";
    compatible = "vendor,fabians-usb-hub";

    chosen {
        zephyr,console = &usart1;
        zephyr,shell-uart = &usart1;
		zephyr,uart-mcumgr = &usart1;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,code-partition = &slot0_partition;
    };

    buttons {
		compatible = "gpio-keys";
		mcuboot_button0: mcuboot_button0 {
			gpios = <&gpiob 4 GPIO_ACTIVE_LOW>;
			label = "DFU-Boot request";
		};
	};

	aliases {
		mcuboot-button0 = &mcuboot_button0;
    };

    usb_hub_ports {
        compatible = "usb-hub-ports";
        status = "okay";
        enable-gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>,  // port 1
                       <&gpioa 2 GPIO_ACTIVE_HIGH>,  // port 2
                       <&gpioa 0 GPIO_ACTIVE_HIGH>,  // port 3
                       <&gpioa 4 GPIO_ACTIVE_HIGH>,  // port 4
                       <&gpiob 5 GPIO_ACTIVE_HIGH>,  // port 5
                       <&gpioc 14 GPIO_ACTIVE_HIGH>; // port 6
        request-gpios = <&gpioa 1 GPIO_ACTIVE_LOW>,  // port 1
                        <&gpiob 0 GPIO_ACTIVE_LOW>,  // port 2
                        <&gpioa 3 GPIO_ACTIVE_LOW>,  // port 3
                        <&gpiob 2 GPIO_ACTIVE_LOW>,  // port 4
                        <&gpioc 15 GPIO_ACTIVE_LOW>, // port 5
                        <&gpiob 4 GPIO_ACTIVE_LOW>;  // port 6
    };

    sram0: memory@20000000 {
        reg = <0x20000000 DT_SIZE_K(10)>;
    };

    soc {
        flash-controller@40023c00 {
            flash0: flash@8000000 {
                reg = <0x08000000 DT_SIZE_K(64)>;
            };
        };
        eeprom: eeprom@8080000 {
            reg = <0x08080000 DT_SIZE_K(4)>;
        };
    };

};

&clk_hsi {
    status = "okay";
};

&rcc {
    clocks = <&clk_hsi>;
    clock-frequency = <DT_FREQ_M(16)>;
    ahb-prescaler = <1>;
    apb1-prescaler = <1>;
    apb2-prescaler = <1>;
};

&iwdg {
    status = "okay";
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 DT_SIZE_K(48)>;
        };
        slot0_partition: partition@C000 {
            label = "image-0";
            reg = <0x0000C000 DT_SIZE_K(80)>;
        };
    };
};

&i2c2 {
    pinctrl-0 = <&i2c2_scl_pb10 &i2c2_sda_pb11>;
    pinctrl-names = "default";
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    hub_i2c: usb2517@2c {
        compatible = "mcp,usb2517";
        status = "okay";
        reg = <0x2c>;
        reset-gpios = <&gpioa 9 GPIO_ACTIVE_LOW>;
        config-gpios = <&gpiob 13 GPIO_ACTIVE_HIGH>,
                       <&gpiob 12 GPIO_ACTIVE_HIGH>;
        suspend-indicator-gpios = <&gpiob 14 GPIO_ACTIVE_LOW>;
    };
};


&usart1 {
    pinctrl-0 = <&usart1_tx_pb6 &usart1_rx_pb7>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};
