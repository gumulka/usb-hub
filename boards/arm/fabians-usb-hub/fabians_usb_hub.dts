/dts-v1/;

#include <st/f0/stm32f072Xb.dtsi>

/ {
	model = "Fabians USB Hub";
	compatible = "vendor,fabians-usb-hub";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>;
		};
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>;
			label = "Button";
		};
	};

	aliases {
		led0 = &led0;
		sw0 = &button0;
	};
};

&clk_hsi {
	status = "okay";
};

&pll {
	prediv = <1>;
	mul = <6>;
	clocks = <&clk_hsi>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(48)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
};

&iwdg {
	status = "okay";
};
