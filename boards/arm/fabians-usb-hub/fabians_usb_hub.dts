/dts-v1/;

#include <st/f0/stm32f072Xb.dtsi>
#include <st/f0/stm32f072r(8-b)tx-pinctrl.dtsi>

/ {
    model = "Fabians USB Hub";
    compatible = "vendor,fabians-usb-hub";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
    };

    usb_hub_ports {
        compatible = "usb-hub-ports";
        status = "okay";
        enable-gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>,  // port 1
                       <&gpioa 2 GPIO_ACTIVE_HIGH>,  // port 2
                       <&gpioa 0 GPIO_ACTIVE_HIGH>,  // port 3
                       <&gpioa 4 GPIO_ACTIVE_HIGH>,  // port 4
                       <&gpiob 5 GPIO_ACTIVE_HIGH>,  // port 5
                       <&gpioc 14 GPIO_ACTIVE_HIGH>; // port 6
        request-gpios = <&gpioa 1 GPIO_ACTIVE_LOW>,  // port 1
                        <&gpiob 0 GPIO_ACTIVE_LOW>,  // port 2
                        <&gpioa 3 GPIO_ACTIVE_LOW>,  // port 3
                        <&gpiob 2 GPIO_ACTIVE_LOW>,  // port 4
                        <&gpioc 15 GPIO_ACTIVE_LOW>, // port 5
                        <&gpiob 4 GPIO_ACTIVE_LOW>;  // port 6
    };
};

&clk_hsi {
    status = "okay";
};

&pll {
    prediv = <1>;
    mul = <6>;
    clocks = <&clk_hsi>;
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <DT_FREQ_M(48)>;
    ahb-prescaler = <1>;
    apb1-prescaler = <1>;
};

&iwdg {
    status = "okay";
};
